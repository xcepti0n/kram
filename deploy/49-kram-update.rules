/* Let the `kram` service user start exactly one unit: kram-update.service.
 *
 * Installed to /etc/polkit-1/rules.d/49-kram-update.rules.
 *
 * Without this the app cannot trigger an update at all — kram.service runs as
 * an unprivileged user and `systemctl start` is a privileged operation. The
 * alternative would have been giving the app sudo or running it as root, both
 * of which grant vastly more than this does.
 *
 * The grant is deliberately narrow: one action, one unit, one user. It does not
 * permit stopping kram.service, starting anything else, or any other systemd
 * verb. What it allows is "install the code that is already on the remote",
 * which is the capability the update feature needs and nothing beyond it.
 */
polkit.addRule(function (action, subject) {
  if (
    action.id === "org.freedesktop.systemd1.manage-units" &&
    action.lookup("unit") === "kram-update.service" &&
    action.lookup("verb") === "start" &&
    subject.user === "kram"
  ) {
    return polkit.Result.YES;
  }
});
