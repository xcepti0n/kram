# Kram — TLS termination.
#
# Installed to /etc/caddy/Caddyfile by deploy/caddy-install.sh, with the domain
# and upstream port substituted in. After editing, run:
#   systemctl reload caddy
#
# Why a self-issued certificate: kram.vaibhavbhatia.net resolves only inside
# this network (an AdGuard rewrite pointing at the container). A public CA will
# not sign for a name it cannot validate from outside, and Let's Encrypt says so
# themselves in "Certificates for localhost" — their advice for this case is to
# issue your own. `tls internal` does exactly that: Caddy runs a small CA in the
# container, signs for this host, and renews indefinitely. Nothing leaves the
# LAN and there is no API token anywhere.
#
# The cost is trusting the CA root once per device — see deploy/README.md.
#
# Note there is deliberately no `log` directive. The Debian package runs Caddy
# under ProtectSystem=full, which remounts /var/log read-only, so pointing a log
# writer there fails at config load and Caddy exits before binding anything.
# The default is journald, which is where the rest of this stack already logs:
#   journalctl -u caddy -f

https://{$KRAM_DOMAIN} {
	tls internal

	encode zstd gzip

	reverse_proxy 127.0.0.1:{$KRAM_PORT} {
		# Without this the app sees 127.0.0.1 as the client for every request.
		header_up X-Real-IP {remote_host}
	}
}
