# Kram — TLS termination.
#
# Installed to /etc/caddy/Caddyfile by deploy/caddy-install.sh, with the domain
# and upstream port substituted in. After editing, run:
#   systemctl reload caddy
#
# Why a self-issued certificate: kram.vaibhavbhatia.net resolves only inside
# this network (an AdGuard rewrite pointing at the container). A public CA will
# not sign for a name it cannot validate from outside, and Let's Encrypt says so
# themselves in "Certificates for localhost" — their advice for this case is to
# issue your own. `tls internal` does exactly that: Caddy runs a small CA in the
# container, signs for this host, and renews indefinitely. Nothing leaves the
# LAN and there is no API token anywhere.
#
# The cost is trusting the CA root once per device — see deploy/README.md.
#
# Note there is deliberately no `log` directive. The Debian package runs Caddy
# under ProtectSystem=full, which remounts /var/log read-only, so pointing a log
# writer there fails at config load and Caddy exits before binding anything.
# The default is journald, which is where the rest of this stack already logs:
#   journalctl -u caddy -f

# Global options. Must be the first block in the file.
#
# Caddy requires the leaf lifetime to be shorter than the intermediate that
# signs it, and the default intermediate is 7 days — so a 30-day leaf (set on
# the issuer below) needs this raised as well, or Caddy refuses the config.
# 8640h is 360 days.
#
# The CA ROOT is untouched and stays at Caddy's 10-year default. That is the one
# trusted on each device; shortening it would mean re-trusting every phone and
# laptop on a schedule.
{
	pki {
		ca local {
			intermediate_lifetime 8640h
		}
	}
}

# Plain HTTP, for one purpose: handing out the CA root (DD-41).
#
# This has to be HTTP. Fetching the root over HTTPS is circular — the browser
# would have to trust the certificate you are downloading in order to download
# it, which is the warning you are trying to remove in the first place.
#
# Serving a public CA root over HTTP is not a leak: it is a public key, it is
# presented to every client during every handshake already, and it authorises
# nothing on its own. What matters is that the file cannot be tampered with in
# transit — on a LAN you control, between your device and this container, that
# is the same trust boundary the rest of this setup already assumes. Verify the
# fingerprint after installing if you want certainty; the installer prints it.
#
# Everything else on :80 redirects to HTTPS, which is Caddy's default behaviour
# and worth keeping explicit here so the exception above is visible.
http://{$KRAM_DOMAIN} {
	handle /kram-root.crt {
		# Served from a published copy, not from Caddy's PKI directory: that
		# one is mode 700 and holds root.key beside root.crt, and pointing a
		# file server at a directory containing a private key rests entirely on
		# the rewrite below being airtight. caddy-install.sh copies the public
		# certificate here, where the key is never in scope.
		root * /var/lib/kram-ca
		rewrite * /kram-root.crt
		# Content-Disposition so iOS offers to install it rather than rendering
		# it as text. The DER/PEM distinction matters to some clients; Caddy
		# writes PEM, which iOS, macOS and Android all accept.
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=kram-root.crt"
		file_server
	}

	handle {
		redir https://{host}{uri} permanent
	}
}

https://{$KRAM_DOMAIN} {
	# 30 days, not Caddy's 12-hour default (DD-41).
	#
	# Short public certificates exist because revocation does not work: a stolen
	# key stays useful until the cert expires. That reasoning does not reach a
	# LAN-only host whose private key never leaves the container — anyone who
	# can steal it already has root, and could simply ask this CA for another.
	#
	# What the default does cost here is real: if the container is off for a
	# day, the leaf is expired at boot and connections fail until Caddy
	# reissues. 30 days removes that window while still exercising renewal
	# often enough that a broken CA shows up in days, not years.
	#
	# The CA ROOT is unaffected and stays at Caddy's 10-year default. That is
	# the one trusted on each device, and shortening it would mean re-trusting
	# every phone and laptop on a schedule.
	# `lifetime` belongs to the ISSUER, not to `tls` — `tls internal { lifetime }`
	# fails with "unknown subdirective: lifetime", which is how this arrived in
	# production the first time.
	#
	# 30 days, against a 12-hour default. Caddy's docs say not to change this
	# without reason; the reason here is that a container which has been off for
	# a day comes back with an expired leaf and refuses connections until it
	# reissues. The revocation argument for short certificates does not apply to
	# a key that never leaves this machine (DD-41).
	tls {
		issuer internal {
			lifetime 720h
		}
	}

	encode zstd gzip

	reverse_proxy 127.0.0.1:{$KRAM_PORT} {
		# Without this the app sees 127.0.0.1 as the client for every request.
		header_up X-Real-IP {remote_host}
	}
}
