# Kram — TLS termination.
#
# Installed to /etc/caddy/Caddyfile by deploy/caddy-install.sh. The domain and
# upstream port are substituted at install time. After editing, run
#   systemctl reload caddy
#
# Why a local CA and not Let's Encrypt: kram.vaibhavbhatia.net exists only in
# this network's DNS (an AdGuard rewrite pointing at 192.168.0.94). A public CA
# will not sign a certificate for a name it cannot validate, and Let's Encrypt
# says so themselves in "Certificates for localhost" — their advice for exactly
# this case is to issue your own. That is what `tls internal` does: Caddy runs a
# small CA, signs for this host, and renews it indefinitely. Nothing leaves the
# LAN and there is no API token anywhere.
#
# The cost is that the CA root has to be trusted once per device. See the
# "Trusting the certificate" section of deploy/README.md.

{
	log {
		output file /var/log/caddy/caddy.log
		level INFO
	}
}

https://{$KRAM_DOMAIN} {
	tls internal

	encode zstd gzip

	reverse_proxy 127.0.0.1:{$KRAM_PORT} {
		# Without these the app sees 127.0.0.1 as the client for every request.
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/kram-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
