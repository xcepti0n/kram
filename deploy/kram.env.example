# Copy to /etc/kram.env and adjust. Read by the systemd unit's EnvironmentFile.
#
# Note the format: systemd parses this itself, so there is no shell here.
# No `export`, no quotes unless they are part of the value, no variable
# expansion, no comments at the end of a value line.

# Port the app listens on. One port serves both the API and the UI (DD-3).
PORT=4310

# Bind address. 0.0.0.0 accepts connections from the LAN, which is what you
# want when reaching this from a phone or over WireGuard. Set 127.0.0.1 if you
# put a reverse proxy in front of it on the same host.
HOST=0.0.0.0

# Where the SQLite file and JSON backups live. Absolute, and the only path the
# unit grants write access to (ReadWritePaths).
DATA_DIR=/opt/kram/data

NODE_ENV=production
