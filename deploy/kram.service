[Unit]
Description=Kram — personal task tracker
# Ordering only. The app owns a local SQLite file and needs no network peer, so
# this must not be a hard dependency: a boot with the network still settling
# should still bring the app up.
After=network-online.target
Wants=network-online.target

# These belong in [Unit], not [Service] — systemd ignores them in [Service],
# which would silently disable the crash-loop protection. Five failures inside
# a minute means the fault is not transient, so stop restarting and leave it
# visible in `systemctl status`.
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=kram
Group=kram

WorkingDirectory=/opt/kram
# DATA_DIR resolves relative to WorkingDirectory when left unset, so the unit
# states it explicitly rather than depending on where systemd happened to start.
EnvironmentFile=/etc/kram.env
ExecStart=/usr/bin/node server/dist/index.js

Restart=always
RestartSec=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kram

# Hardening, limited to what an unprivileged LXC can actually do.
#
# The mount-namespace directives — ProtectSystem, PrivateTmp, PrivateDevices,
# ProtectHome, ProtectKernelTunables/Modules, ProtectControlGroups — all need to
# remount /proc, which an unprivileged container is not permitted to do. Setting
# them there does not harden anything: the unit fails to start at all, with
# status=226/NAMESPACE. They are the right settings on bare metal or a VM and
# the wrong ones here.
#
# What remains needs no namespace and still removes the paths that matter:
# privilege escalation, setuid abuse, and the kernel-facing capability surface.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

# RestrictAddressFamilies is deliberately NOT set. It reads like it only covers
# the sockets the app opens, but enumerating network interfaces — which Fastify
# does on listen, to log the bound addresses — goes through AF_NETLINK. Blocking
# it makes uv_interface_addresses fail with EAFNOSUPPORT (errno 97) and the
# process exits after successfully binding the port. The listener is already
# constrained by HOST in /etc/kram.env, which is the control that matters.

# The LXC is the isolation boundary here (DD-1); the container's own root
# filesystem is what a compromise would be confined to. Filesystem confinement
# below that is the container's job, not systemd's.

# A single-user tracker on a home network. The cap exists to turn a runaway
# import into a restart rather than an OOM that takes the container with it.
MemoryMax=512M

[Install]
WantedBy=multi-user.target
