{
  "name": "@tasktracker/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "concurrently -k -n tsc,node -c gray,cyan \"npm:dev:types\" \"npm:dev:run\"",
    "dev:types": "tsc --build --watch --preserveWatchOutput",
    "dev:run": "node --watch dist/index.js",
    "build": "tsc --build"
  },
  "dependencies": {
    "@fastify/static": "^8.0.3",
    "@tasktracker/shared": "*",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  }
}
